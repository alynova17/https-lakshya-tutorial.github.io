<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>Lakshya Tutorial | Learn • Develop • Achieve</title>

  <meta name="description"
        content="Lakshya Tutorial is a student-focused educational and skill-development platform.">

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      scroll-behavior: smooth;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      line-height: 1.6;
      background: #f7f9fc;
      color: #172033;
    }

    a {
      text-decoration: none;
      color: inherit;
    }

    .container {
      width: 90%;
      max-width: 1150px;
      margin: auto;
    }

    /* NAVBAR */
    header {
      background: #ffffff;
      border-bottom: 1px solid #e6eaf0;
      position: sticky;
      top: 0;
      z-index: 1000;
    }

    nav {
      min-height: 70px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 20px;
    }

    .logo {
      font-size: 24px;
      font-weight: 800;
      color: #2457d6;
    }

    .logo span {
      color: #111827;
    }

    .nav-links {
      display: flex;
      list-style: none;
      gap: 20px;
      flex-wrap: wrap;
    }

    .nav-links a {
      font-size: 14px;
      font-weight: 600;
      color: #39445a;
    }

    .nav-links a:hover {
      color: #2457d6;
    }

    /* HERO */
    .hero {
      background: linear-gradient(135deg, #eef4ff, #ffffff);
      padding: 90px 0;
    }

    .hero-content {
      display: grid;
      grid-template-columns: 1.2fr 0.8fr;
      gap: 50px;
      align-items: center;
    }

    .badge {
      display: inline-block;
      background: #e1ebff;
      color: #2457d6;
      padding: 7px 14px;
      border-radius: 30px;
      font-size: 13px;
      font-weight: bold;
      margin-bottom: 18px;
    }

    .hero h1 {
      font-size: clamp(40px, 6vw, 65px);
      line-height: 1.05;
      margin-bottom: 20px;
    }

    .hero h1 span {
      color: #2457d6;
    }

    .hero p {
      font-size: 18px;
      color: #596579;
      max-width: 650px;
      margin-bottom: 30px;
    }

    .buttons {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 13px 22px;
      border-radius: 8px;
      font-weight: bold;
      border: 1px solid #2457d6;
      transition: 0.2s;
    }

    .btn-primary {
      background: #2457d6;
      color: white;
    }

    .btn-primary:hover {
      background: #1745b5;
    }

    .btn-secondary {
      color: #2457d6;
      background: white;
    }

    .hero-card {
      background: white;
      padding: 30px;
      border-radius: 18px;
      box-shadow: 0 15px 45px rgba(20, 40, 80, 0.10);
      border: 1px solid #e7ebf2;
    }

    .hero-card h3 {
      margin-bottom: 18px;
      font-size: 22px;
    }

    .hero-card-item {
      display: flex;
      justify-content: space-between;
      padding: 13px 0;
      border-bottom: 1px solid #edf0f5;
    }

    .hero-card-item:last-child {
      border-bottom: none;
    }

    /* GENERAL SECTIONS */
    section {
      padding: 75px 0;
    }

    .section-heading {
      text-align: center;
      max-width: 720px;
      margin: 0 auto 45px;
    }

    .section-heading h2 {
      font-size: 36px;
      margin-bottom: 12px;
    }

    .section-heading p {
      color: #667085;
    }

    /* CARDS */
    .grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 22px;
    }

    .card {
      background: white;
      padding: 28px;
      border: 1px solid #e5e9f0;
      border-radius: 14px;
      transition: 0.2s;
    }

    .card:hover {
      transform: translateY(-4px);
      box-shadow: 0 12px 30px rgba(20, 40, 80, 0.08);
    }

    .icon {
      font-size: 32px;
      margin-bottom: 15px;
    }

    .card h3 {
      margin-bottom: 9px;
    }

    .card p {
      color: #667085;
      font-size: 15px;
    }

    /* COURSES */
    .course-card {
      overflow: hidden;
      padding: 0;
    }

    .course-top {
      padding: 25px;
      background: #eef4ff;
    }

    .course-body {
      padding: 25px;
    }

    .course-body ul {
      padding-left: 18px;
      margin: 15px 0;
      color: #667085;
    }

    .course-tag {
      display: inline-block;
      font-size: 12px;
      font-weight: bold;
      background: white;
      color: #2457d6;
      padding: 5px 9px;
      border-radius: 20px;
      margin-bottom: 10px;
    }

    /* DEVELOPMENT */
    .development {
      background: #111827;
      color: white;
    }

    .development .section-heading p {
      color: #c5cad4;
    }

    .development .card {
      background: #1b2434;
      border-color: #2c374a;
      color: white;
    }

    .development .card p {
      color: #c5cad4;
    }

    /* STUDENT PROFILE */
    .profile {
      display: grid;
      grid-template-columns: 0.8fr 1.2fr;
      gap: 30px;
      align-items: stretch;
    }

    .profile-box {
      background: white;
      border: 1px solid #e5e9f0;
      border-radius: 15px;
      padding: 30px;
    }

    .student-avatar {
      width: 100px;
      height: 100px;
      border-radius: 50%;
      background: #e1ebff;
      color: #2457d6;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 35px;
      font-weight: bold;
      margin-bottom: 18px;
    }

    .profile-list {
      list-style: none;
    }

    .profile-list li {
      padding: 10px 0;
      border-bottom: 1px solid #edf0f5;
    }

    /* STATS */
    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 20px;
    }

    .stat {
      background: white;
      border: 1px solid #e5e9f0;
      padding: 25px;
      text-align: center;
      border-radius: 14px;
    }

    .stat h3 {
      font-size: 34px;
      color: #2457d6;
    }

    .stat p {
      color: #667085;
    }

    /* BLOG */
    .blog-card {
      padding: 0;
      overflow: hidden;
    }

    .blog-image {
      height: 150px;
      background: #e1ebff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 45px;
    }

    .blog-content {
      padding: 24px;
    }

    /* ABOUT */
    .about {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 40px;
      align-items: center;
    }

    .about-box {
      background: white;
      padding: 35px;
      border-radius: 15px;
      border: 1px solid #e5e9f0;
    }

    .check-list {
      list-style: none;
      margin-top: 20px;
    }

    .check-list li {
      margin: 12px 0;
    }

    /* CONTACT */
    .contact-box {
      max-width: 750px;
      margin: auto;
      background: white;
      padding: 35px;
      border-radius: 15px;
      border: 1px solid #e5e9f0;
    }

    form {
      display: grid;
      gap: 15px;
    }

    input,
    textarea {
      width: 100%;
      padding: 13px;
      border: 1px solid #d8dee9;
      border-radius: 8px;
      font: inherit;
    }

    textarea {
      min-height: 130px;
      resize: vertical;
    }

    button {
      cursor: pointer;
      border: none;
      font: inherit;
    }

    /* FOOTER */
    footer {
      background: #111827;
      color: #c5cad4;
      padding: 45px 0 25px;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 2fr 1fr 1fr;
      gap: 35px;
      margin-bottom: 35px;
    }

    footer h3,
    footer h4 {
      color: white;
      margin-bottom: 12px;
    }

    footer ul {
      list-style: none;
    }

    footer li {
      margin: 7px 0;
    }

    .copyright {
      border-top: 1px solid #2c374a;
      padding-top: 20px;
      text-align: center;
      font-size: 13px;
    }

    /* MOBILE */
    @media (max-width: 850px) {
      .hero-content,
      .profile,
      .about {
        grid-template-columns: 1fr;
      }

      .grid {
        grid-template-columns: repeat(2, 1fr);
      }

      .stats {
        grid-template-columns: repeat(2, 1fr);
      }

      .footer-grid {
        grid-template-columns: 1fr 1fr;
      }

      nav {
        flex-direction: column;
        padding: 15px 0;
      }

      .nav-links {
        justify-content: center;
      }
    }

    @media (max-width: 550px) {
      .grid,
      .stats,
      .footer-grid {
        grid-template-columns: 1fr;
      }

      section {
        padding: 55px 0;
      }

      .hero {
        padding: 60px 0;
      }

      .section-heading h2 {
        font-size: 29px;
      }
    }
  </style>
</head>

